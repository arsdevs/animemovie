  <meta charset="UTF-8">
  <title>Anime Videos</title>
  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Press Start 2P', cursive;
      background: #1a1a1a;
      color: #f0f0f0;
      padding: 20px;
      text-align: center;
    }

    h1, h2 {
      margin-bottom: 20px;
    }

    .video-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr); /* Two videos per row */
  gap: 30px;
  margin-top: 3rem;
  justify-items: center;
  max-width: 100vw; 
}

iframe {
  border: 3px solid #fff;
  border-radius: 12px;
  box-shadow: 0 0 10px #00ff99;
  width: 100%;
  max-width: 560px;
  height: 315px; 
  aspect-ratio: 16 / 9;
}

@media (max-width: 768px) {
  .video-grid {
    grid-template-columns: 1fr; /* One video per row on mobile/tablet */
  }
  .video-iframe{
    max-width: 100vw;
  }
  iframe {
    max-width: 95%; 
    height: auto; 
  }
}
.home-btn{
  font-size: 0.8rem;
}
    p a {
      display: inline-block;
      margin-top: 30px;
      color: #00ff99;
      text-decoration: none;
      border: 2px solid #00ff99;
      padding: 10px 20px;
      border-radius: 8px;
      transition: 0.2s ease;
    }

    p a:hover {
      background: #00ff99;
      color: #1a1a1a;
    }

    .episode-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr); /* 5 items per row */
  gap: 20px;
  margin-top: 3rem;
  justify-items: center;
  width: 100%;
  max-width: 1000px; 
}

.episode-grid img {
  border-radius: 8px;
  box-shadow: 0 0 8px rgba(0, 255, 153, 0.8); /* Add a nice shadow around images */
  width: 100%; /* Ensure images take full width of container */
  max-width: 200px; /* Limit max image size */
  height: auto; /* Keep the image aspect ratio intact */
}

@media (max-width: 1200px) {
  .episode-grid {
    grid-template-columns: repeat(4, 1fr); /* 4 items per row on medium screens */
  }
}

@media (max-width: 992px) {
  .episode-grid {
    grid-template-columns: repeat(3, 1fr); /* 3 items per row on smaller screens */
  }
}

@media (max-width: 768px) {
  .episode-grid {
    grid-template-columns: repeat(2, 1fr); /* 2 items per row on tablets */
    justify-content: center; /* Center content on small screens */
  }
}

@media (max-width: 480px) {
  .episode-grid {
    grid-template-columns: 1fr; /* 1 item per row on mobile */
  }
}

  </style>
</head>
<body>


  <% if (videos.promo && videos.promo.length > 0) { %>
    <div class="video-grid">
      <% videos.promo.forEach(video => { %>
        <% if (video.trailer && video.trailer.embed_url) { %>
          <div class="video-iframe">
            <p><%= video.title %></p>
            <iframe src="<%= video.trailer.embed_url %>" allowfullscreen></iframe>
          </div>
        <% } %>
      <% }) %>
    </div>
  <% } else { %>
    <p>No Videos available.</p>
  <% } %>

