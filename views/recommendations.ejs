
<!DOCTYPE html>
<html lang="en">
<head>
  <script src='//whephiwums.com/sdk.js' data-zone='9278507' data-sdk='show_9278507'></script>
  <meta charset="UTF-8">
  <title>Anime Recommendations</title>
  <style>
    .recommendations-container {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
      margin-top: 4rem;
    }
    .recommendation-item {
      width: 200px;
      text-align: center;
    }
    .recommendation-item img {
      width: 100%;
      border-radius: 10px;
    }
    .recommendation-item h3 {
      font-size: 1.1rem;
      margin-top: 10px;
    }
    .recommendation-item a {
      text-decoration: none;
      color: #00ff99;
    }

    .nav-center {
  text-align: center;
  margin-top: 40px;
}

.nav-center a {
  display: inline-block;
  color: #00ff99;
  text-decoration: none;
  border: 2px solid #00ff99;
  padding: 10px 24px;
  border-radius: 6px;
  transition: background 0.25s ease, color 0.25s ease;
  font-weight: 500;
  font-size: 1rem;
  background-color: transparent;
}

.nav-center a:hover {
  background-color: #00ff99;
  color: #1a1a1a;
}

  </style>
</head>
<body>
  <div class="recommendations-container">
    <% recommendations.forEach(recommendation => { %>
      <div class="recommendation-item">
        <% const anime = recommendation.entry; %>
        <img src="<%= anime.images.jpg.image_url %>" alt="<%= anime.title %> Poster">
        <h3><%= anime.title %></h3>
      </div>
    <% }) %>
  </div>

  <p class="nav-center">
    <a href="/">← Back to Home</a>
  </p>

  <script>
    const FIRST_AD_DELAY =5*60 * 1000; // 5 minutes
    const AD_INTERVAL = 30 * 60 * 1000;   // 30 minutes
  
    function showAd() {
      console.log('Showing ad at', new Date().toLocaleTimeString());
      show_9278507({ 
        type: 'inApp', 
        inAppSettings: { 
          frequency: 2,
          capping: 0.1,
          interval: 30,
          timeout: 5,
          everyPage: false
        }
      });
    }
  
    // First ad after 5 minutes
    setTimeout(() => {
      showAd();
  
      // Then repeat every 30 minutes
      setInterval(showAd, AD_INTERVAL);
    }, FIRST_AD_DELAY);
  </script>
  
</body>
</html>
