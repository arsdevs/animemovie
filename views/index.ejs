<script>
  const FIRST_AD_DELAY =5*60 * 1000; // 5 minutes
  const AD_INTERVAL = 30 * 60 * 1000;   // 30 minutes

  function showAd() {
    console.log('Showing ad at', new Date().toLocaleTimeString());
    show_9278507({ 
      type: 'inApp', 
      inAppSettings: { 
        frequency: 2,
        capping: 0.1,
        interval: 30,
        timeout: 5,
        everyPage: false
      }
    });
  }

  // First ad after 5 minutes
  setTimeout(() => {
    showAd();

    // Then repeat every 30 minutes
    setInterval(showAd, AD_INTERVAL);
  }, FIRST_AD_DELAY);
</script>


</body>
</html>
